{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/knst0/mdl/main/schema/config.schema.json",
  "title": "mdl config",
  "description": "Configuration schema for mdl — a manga downloader CLI",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference for editor tooling"
    },
    "version": {
      "type": "integer",
      "description": "Config schema version (used for automatic migrations)"
    },
    "application": {
      "type": "object",
      "properties": {
        "check_updates": {
          "type": "boolean",
          "description": "Check for new mdl releases on startup"
        },
        "max_parallel_downloads": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum concurrent page/image downloads"
        },
        "max_parallel_chapters": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum concurrent chapter downloads"
        }
      }
    },
    "output": {
      "type": "object",
      "properties": {
        "directory": {
          "type": "string",
          "description": "Download output directory"
        },
        "clean_on_start": {
          "type": "boolean",
          "description": "Remove all files from the output directory on startup"
        },
        "file_format": {
          "type": "string",
          "enum": ["auto", "png", "jpeg", "avif", "webp"],
          "description": "Output image format"
        }
      }
    },
    "site": {
      "type": "object",
      "description": "Per-site configuration keyed by hostname",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "cookie": {
            "type": "string",
            "description": "Session cookie for authenticated access to this site"
          }
        }
      }
    }
  }
}
